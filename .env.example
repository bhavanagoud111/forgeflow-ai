# Copy to .env (Docker Compose) or export in your shell (local development).
# Never commit real values.

# --- Required -----------------------------------------------------------------
# Bootstrap admin API token (hashed at startup). Generate one: openssl rand -hex 32
FORGEFLOW_ADMIN_TOKEN=change-me
# Shared secret between the worker and the sandbox-runner service (Compose only).
FORGEFLOW_RUNNER_TOKEN=change-me-too

# --- Model provider -------------------------------------------------------------
# demo = deterministic offline provider (scripted output, no API key needed).
# anthropic | openai | ollama = real models through LangChain (install the matching extra).
FORGEFLOW_LLM_PROVIDER=demo
FORGEFLOW_LLM_MODEL=claude-opus-5-5
FORGEFLOW_LLM_API_KEY=
# FORGEFLOW_LLM_BASE_URL=

# --- Sandbox ----------------------------------------------------------------------
# local  = subprocess with rlimits (tests/demo only; refuses model-generated code)
# docker = one container per command (needs `make sandbox-image`)
# runner = sandbox-runner service (Docker Compose)
FORGEFLOW_SANDBOX_MODE=local
# FORGEFLOW_ALLOW_UNSAFE_LOCAL_SANDBOX=false
# FORGEFLOW_ALLOW_DEPENDENCY_INSTALL=false

# --- GitHub (optional; read-only demo mode without it) ----------------------------
# Fine-grained token scoped to selected repositories: Contents (read/write),
# Pull requests (read/write), Issues (read), Commit statuses/Checks (read).
FORGEFLOW_GITHUB_TOKEN=
# Or a GitHub App:
# FORGEFLOW_GITHUB_APP_ID=
# FORGEFLOW_GITHUB_APP_PRIVATE_KEY=
# FORGEFLOW_GITHUB_APP_INSTALLATION_ID=

# --- Slack (optional) --------------------------------------------------------------
FORGEFLOW_SLACK_SIGNING_SECRET=
FORGEFLOW_SLACK_BOT_TOKEN=
# JSON map of Slack user IDs to roles (viewer | operator | admin).
# FORGEFLOW_SLACK_USER_ROLES={"U012ABCDEF":"operator"}

# --- Storage (local development defaults shown) -------------------------------------
# FORGEFLOW_DATABASE_URL=sqlite+aiosqlite:///./forgeflow.db
# FORGEFLOW_CHECKPOINT_URL=sqlite:///./forgeflow-checkpoints.db
# FORGEFLOW_REDIS_URL=redis://localhost:6379/0

# --- Observability -------------------------------------------------------------------
# FORGEFLOW_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LangSmith tracing of model calls (optional, standard LangChain variables):
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
